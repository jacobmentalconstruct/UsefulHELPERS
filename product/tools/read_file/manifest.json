{
  "contract_version": 1,
  "id": "read_file",
  "description": "Read bounded UTF-8 text from one target-relative file.",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {"type": "string", "minLength": 1},
      "max_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000}
    },
    "required": ["path"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "tool": {"type": "string"},
      "handle": {"type": "string"},
      "content": {"type": "string"},
      "bytes_returned": {"type": "integer"},
      "truncated": {"type": "boolean"},
      "error": {"type": "string"},
      "error_kind": {"type": "string"}
    },
    "required": ["ok"],
    "additionalProperties": false
  },
  "reads": ["target"],
  "writes": [],
  "applicability": {"domains": ["generic"], "requires": ["text_file"]},
  "path_arguments": {"path": "target"},
  "invocation": {"kind": "python", "entry": "tools/read_file/tool.py"}
}
