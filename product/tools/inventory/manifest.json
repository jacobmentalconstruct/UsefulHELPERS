{
  "contract_version": 1,
  "id": "inventory",
  "description": "Enumerate target files and directories without entering the instrument subtree.",
  "authority": "observe",
  "input_schema": {
    "type": "object",
    "properties": {
      "limit": {"type": "integer", "minimum": 1, "maximum": 10000}
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "tool": {"type": "string"},
      "target": {"type": "string"},
      "returned": {"type": "integer"},
      "truncated": {"type": "boolean"},
      "resources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "handle": {"type": "string"},
            "path": {"type": "string"},
            "kind": {"type": "string"},
            "size_bytes": {"type": ["integer", "null"]}
          },
          "required": ["handle", "path", "kind"],
          "additionalProperties": false
        }
      },
      "limitations": {"type": "array", "items": {"type": "string"}},
      "error": {"type": "string"},
      "error_kind": {"type": "string"}
    },
    "required": ["ok"],
    "additionalProperties": false
  },
  "reads": ["target"],
  "writes": [],
  "applicability": {"domains": ["generic"], "empty_target": true},
  "path_arguments": {},
  "invocation": {"kind": "python", "entry": "tools/inventory/tool.py"}
}
